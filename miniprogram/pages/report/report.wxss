.page {
  padding: 24rpx 28rpx 60rpx
}

.card {
  background: #131F33;
  border: 1rpx solid #24334B;
  border-radius: 20rpx;
  padding: 30rpx 28rpx;
  margin-bottom: 24rpx
}

.field-label {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 24rpx
}

.req {
  color: #F26D6D;
  margin-left: 6rpx
}

/* 标签选择 */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx
}

.chip {
  background: #16243C;
  border: 1rpx solid #2C3F5E;
  color: #AEBDD4;
  font-size: 27rpx;
  padding: 14rpx 36rpx;
  border-radius: 999rpx
}

.chip-on {
  background: #20C7A5;
  border-color: #20C7A5;
  color: #06251F;
  font-weight: 700
}

/* 输入 */
.inner-input {
  box-sizing: border-box;
  width: 100%;
  background: #0D1728;
  border: 1rpx solid #2A3B56;
  border-radius: 12rpx;
  padding: 22rpx;
  color: #E8EEF8
}

.inner-textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 150rpx;
  background: #0D1728;
  border: 1rpx solid #2A3B56;
  border-radius: 12rpx;
  padding: 22rpx;
  color: #E8EEF8;
  margin-top: 20rpx
}

/* 照片九宫格 */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx
}

.photo-item {
  position: relative;
  width: 160rpx;
  height: 160rpx
}

.photo-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx
}

.photo-del {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #F26D6D;
  color: #fff;
  font-size: 28rpx;
  line-height: 40rpx;
  text-align: center
}

.photo-add {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed #3A5E8C;
  border-radius: 12rpx;
  background: #0E1B2E;
  color: #4DA3FF;
  font-size: 56rpx;
  font-weight: 300;
  display: flex;
  align-items: center;
  justify-content: center
}

/* 上门位置 */
.loc-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 4rpx
}

.loc-btn {
  background: #123049;
  border: 1rpx solid #2C5A87;
  color: #4DA3FF;
  font-size: 27rpx;
  padding: 14rpx 30rpx;
  border-radius: 10rpx;
  flex-shrink: 0
}

.loc-hint {
  color: #8C9AB2;
  font-size: 25rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap
}

/* 提交按钮 */
.submit-btn {
  margin-top: 10rpx;
  background: linear-gradient(90deg, #2E9BE8, #1E6FE0);
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 16rpx;
  border: 0
}

.submit-btn:after {
  border: 0
}

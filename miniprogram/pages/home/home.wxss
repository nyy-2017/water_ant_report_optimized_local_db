.page {
  padding: 30rpx 28rpx 60rpx
}

/* 顶部主卡片 */
.hero {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #16283F 0%, #101B2E 70%);
  border: 1rpx solid #24334B;
  border-radius: 24rpx;
  padding: 40rpx 34rpx;
  margin-bottom: 26rpx
}

.hero-water { position: absolute; right: 22rpx; bottom: -28rpx; font-size: 150rpx; font-weight: 900; color: rgba(97,224,198,.08); }

.hero-eyebrow {
  color: #20C7A5;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  margin-bottom: 22rpx
}

.hero-title {
  font-size: 48rpx;
  font-weight: 700;
  margin-bottom: 14rpx
}

.hero-sub {
  color: #8C9AB2;
  font-size: 26rpx
}

/* 未登录提示 */
.login-hint {
  background: #131F33;
  border: 1rpx solid #24334B;
  border-radius: 22rpx;
  padding: 56rpx 40rpx;
  text-align: center;
  margin-bottom: 26rpx
}

.login-hint-text {
  color: #8C9AB2;
  font-size: 28rpx;
  margin-bottom: 36rpx
}

.login-btn {
  background: linear-gradient(90deg, #2BB3FF, #20C7A5);
  color: #06202B;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 44rpx;
  padding: 0 90rpx;
  line-height: 88rpx
}

.login-btn:after {
  border: 0
}

/* 统计三宫格 */
.stats {
  display: flex;
  gap: 18rpx;
  margin-bottom: 36rpx
}

.stat-card {
  flex: 1;
  background: #131F33;
  border: 1rpx solid #24334B;
  border-radius: 18rpx;
  padding: 24rpx 12rpx;
  text-align: center
}

.stat-num {
  font-size: 42rpx;
  font-weight: 700;
  color: #20C7A5;
  margin-bottom: 8rpx
}

.stat-label {
  color: #8C9AB2;
  font-size: 23rpx
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 20rpx
}

/* 快捷操作行 */
.action {
  display: flex;
  align-items: center;
  background: #131F33;
  border: 1rpx solid #24334B;
  border-radius: 20rpx;
  padding: 28rpx 26rpx;
  margin-bottom: 22rpx
}

.pressed {
  background: #182740
}

.action-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 24rpx;
  flex-shrink: 0
}

.icon-green {
  background: #143C34;
  color: #20C7A5
}

.icon-blue {
  background: #1B3050;
  color: #7FA8DC
}

.action-body {
  flex: 1;
  min-width: 0
}

.action-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 8rpx
}

.action-sub {
  color: #8C9AB2;
  font-size: 24rpx
}

.chevron {
  color: #55677F;
  font-size: 40rpx;
  margin-left: 12rpx
}

/* 上报提示 */
.tip {
  background: #122033;
  border: 1rpx solid #1F3350;
  border-left: 6rpx solid #20C7A5;
  border-radius: 16rpx;
  padding: 28rpx 26rpx;
  margin-top: 10rpx
}

.tip-title {
  font-weight: 700;
  margin-bottom: 14rpx
}

.tip-text {
  color: #8C9AB2;
  font-size: 25rpx;
  line-height: 1.7
}

.footer {
  text-align: center;
  color: #55677F;
  font-size: 22rpx;
  margin-top: 46rpx
}

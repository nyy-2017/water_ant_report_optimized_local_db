<view class="page">
  <block wx:if="{{logged}}">
    <!-- 头部卡片 -->
    <view class="head-card">
      <image wx:if="{{user.avatar}}" class="avatar" src="{{user.avatar}}" mode="aspectFill" />
      <view wx:else class="avatar avatar-ph">{{reportCount}}</view>
      <view class="head-name">{{user.name}}</view>
      <view class="head-role muted">{{user.role_text || user.role_name || '工作人员'}}</view>
    </view>

    <block wx:if="{{!editing}}">
      <!-- 资料展示 -->
      <view class="card">
        <view class="row">
          <view class="row-label">姓名</view>
          <view class="row-value">{{user.name}}</view>
        </view>
        <view class="row">
          <view class="row-label">性别</view>
          <view class="row-value">{{user.gender || '未知'}}</view>
        </view>
        <view class="row">
          <view class="row-label">手机号</view>
          <view class="row-value {{user.phone ? '' : 'muted'}}">{{user.phone || '未填写'}}</view>
        </view>
        <view class="row" bindtap="goRecords" hover-class="pressed">
          <view class="row-label">上报记录</view>
          <view class="row-value">{{reportCount}} 条 ›</view>
        </view>
      </view>

      <button class="primary-btn" bindtap="startEdit">编辑资料</button>
      <button class="danger-btn" bindtap="logout">退出登录</button>
    </block>

    <block wx:else>
      <!-- 资料编辑 -->
      <view class="card">
        <view class="row avatar-row">
          <view class="row-label">头像</view>
          <view class="avatar-edit" bindtap="chooseAvatar">
            <image wx:if="{{form.avatar}}" class="avatar-s" src="{{form.avatar}}" mode="aspectFill" />
            <view wx:else class="avatar-s avatar-ph-s">换</view>
            <view class="avatar-tip">换头像</view>
          </view>
        </view>
        <view class="row">
          <view class="row-label">姓名</view>
          <input class="row-input" placeholder="必填" placeholder-class="ph" value="{{form.name}}" data-field="name" bindinput="onInput" />
        </view>
        <view class="row">
          <view class="row-label">性别</view>
          <picker range="{{genders}}" value="{{genderIndex}}" bindchange="onGender">
            <view class="row-value picker-value">{{form.gender}} ▾</view>
          </picker>
        </view>
        <view class="row">
          <view class="row-label">手机号</view>
          <input class="row-input" type="number" placeholder="便于上门联系" placeholder-class="ph" value="{{form.phone}}" data-field="phone" bindinput="onInput" />
        </view>
      </view>

      <button class="primary-btn" loading="{{saving}}" bindtap="save">保存</button>
      <button class="secondary-btn" bindtap="cancelEdit">取消</button>
    </block>
  </block>

  <view wx:else class="login-hint">
    <view class="login-hint-text">登录后查看个人资料与上报记录</view>
    <button class="login-btn" bindtap="goLogin">立即登录</button>
  </view>
</view>

<view class="page">
  <view class="header">
    <view>
      <view class="header-title">我的上报记录</view>
      <view class="header-sub">共 {{items.length}} 条记录</view>
    </view>
    <view class="new-btn" bindtap="report">＋ 上报</view>
  </view>

  <view class="filters">
    <view
      wx:for="{{filters}}"
      wx:key="key"
      class="chip {{filter === item.key ? 'chip-active' : ''}}"
      data-key="{{item.key}}"
      bindtap="setFilter"
    >{{item.label}}</view>
  </view>

  <block wx:if="{{filtered.length}}">
    <view class="card" wx:for="{{filtered}}" wx:key="id" data-id="{{item.id}}" bindtap="detail" hover-class="pressed">
      <view class="row">
        <text class="code">{{item.code}}</text>
        <text class="status">{{item.status}}</text>
      </view>
      <view class="location">{{item.location}}</view>
      <view class="meta">{{item.type}} · {{item.date}}</view>
      <view class="desc">{{item.description}}</view>
      <view class="photos" wx:if="{{item.photos.length}}">现场照片 {{item.photos.length}} 张</view>
    </view>
  </block>

  <view wx:else class="empty">
    <view class="empty-icon">⌕</view>
    <view class="empty-title">暂无上报记录</view>
    <view class="empty-sub">发现白蚁隐患后，可立即新增上报</view>
    <view class="empty-btn" bindtap="report">新增上报</view>
  </view>
</view>

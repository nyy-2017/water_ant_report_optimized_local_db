<view class="page">
  <view class="brand">
    <view class="brand-title">登录</view>
    <view class="brand-sub">登录后可上报隐患、跟踪处理进度</view>
  </view>

  <view class="card">
    <view class="field">
      <view class="field-label">账号</view>
      <input class="field-input" placeholder="请输入账号" placeholder-class="ph" value="{{username}}" data-field="username" bindinput="onInput" />
    </view>
    <view class="field">
      <view class="field-label">密码</view>
      <input class="field-input" password placeholder="请输入密码" placeholder-class="ph" value="{{password}}" data-field="password" bindinput="onInput" />
    </view>
  </view>

  <button class="submit-btn" loading="{{loading}}" bindtap="submit">登 录</button>
  <view class="foot-note">登录后可将上报记录关联到你的账号</view>
</view>

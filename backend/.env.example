PORT=3030
# 请替换为至少32位随机字符串
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
# 首次启动时创建管理员；请务必设置强密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisPassword-AtLeast6Chars
# 相对路径均以 backend/ 目录为基准
DB_PATH=./data/water-ant.sqlite
UPLOAD_DIR=./uploads
# 本地开发可留空；部署时填写 API 的 HTTPS 公网地址
PUBLIC_BASE_URL=http://localhost:3030
CORS_ORIGIN=http://localhost:8080
